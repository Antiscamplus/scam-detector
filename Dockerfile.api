FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 HF_HOME=/app/.cache/huggingface
RUN apt-get update && apt-get install -y ffmpeg curl libsndfile1 git && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY main_api.py detector.py line_service.py diarization.py ./
COPY data ./data
EXPOSE 8000
CMD ["uvicorn","main_api:app","--host","0.0.0.0","--port","8000","--workers","1"]
